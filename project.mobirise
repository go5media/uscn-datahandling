          "_name": "contacts01",
          "_sourceTheme": "fantasym5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"contacts01 fantasym5\" group=\"Contacts\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Container BG\" value=\"#2f1d41\" name=\"containerBg\" selected>\n        <header>List</header>\n        <input type=\"range\" inline title=\"Items Amount\" name=\"itemsAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"1\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\">\n        <input type=\"color\" title=\"Active Color\" value=\"#ffffff\" name=\"activeColor\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/fantasym5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/fantasym5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-11\">\n                <div class=\"card-wrapper\">\n                    <div class=\"row justify-content-between\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-7\">\n                            <div class=\"title-wrapper\" mbr-if=\"showTitle || showText\">\n                                <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                                    <b>We’re Here to Help You</b></h2>\n                                <div class=\"text-wrapper\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                        <b>Have a question or want to request your data? Reach out to our\n                                            team</b><b>.</b>\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"items-wrapper\">\n                                <div class=\"item-wrap\">\n                                    <div class=\"address-wrap\">\n                                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-phone mobi-mbri\" style=\"color: rgb(242, 118, 150); fill: rgb(242, 118, 150);\"></span>\n                                        </div>\n                                        <a href=\"#\">\n                                            <p class=\"item-title card-wrap mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .item-wrap\"><b>Direct: 0330 520 4085</b><br><b>Main 0330 520 1223 Ext 4085</b><b><br></b></p>\n                                        </a>\n                                    </div>\n                                </div>\n                                <div class=\"item-wrap\">\n                                    <div class=\"address-wrap\">\n                                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\" style=\"color: rgb(242, 118, 150); fill: rgb(242, 118, 150);\"></span>\n                                        </div>\n                                        <a href=\"#\">\n                                            <p class=\"item-title card-wrap mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .item-wrap\"><b><br>General Data Contacts</b><b><br></b><br><b>Network&nbsp;<br>dpo@uscn.org.uk</b><b><br></b><br><b>Commercial&nbsp;</b><br><b>dpo@uscn.uk</b></p>\n                                        </a>\n                                    </div>\n                                </div>\n                                <div class=\"item-wrap\">\n                                    <div class=\"address-wrap\">\n                                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-map-pin mobi-mbri\" style=\"color: rgb(242, 118, 150); fill: rgb(242, 118, 150);\">\n                                                    </span>\n                                        </div>\n                                        <a href=\"#\">\n                                            <p class=\"item-title card-wrap mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title, .item-wrap\">Site Updated: 18/10/2026</p>\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-5\">\n                            <div class=\"image-wrapper\">\n                                <img src=\"@PROJECT_PATH@/assets/images/20261013-170107-2000x1500.jpeg\" alt=\"Axis USCN CCTV Dome Image\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
