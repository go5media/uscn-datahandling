                      "width": "100%"
                    }
                  }
                }
              },
              ".items-wrapper": {
                ".item-wrap": {
                  "margin-top": "15px",
                  "&:first-child": {
                    "margin-bottom": "0"
                  },
                  ".address-wrap": {
                    "display": "inline-flex",
                    "align-items": "center",
                    "gap": "10px",
                    ".iconfont-wrapper": {
                      ".mbr-iconfont": {
                        "font-size": "22px",
