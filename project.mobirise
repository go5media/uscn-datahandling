                      "margin-bottom": "0",
                      "transition": "all .5s ease",
                      "&:hover, &:focus": {
                        "color": "@activeColor"
                      }
                    }
                  }
                }
              },
              ".image-wrapper": {
                "position": "relative",
                "min-height": "220px",
                "height": "100%",
                "@media (max-width: 992px)": {
                  "margin-top": "30px",
                  "margin-bottom": "-20px",
                  "min-height": "auto",
                  "height": "300px"
                },
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "150%",
                  "object-fit": "cover",
                  "@media (max-width: 992px)": {
                    "height": "100%",
                    "bottom": "0"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#ffffff"
            },
            ".item-title": {
              "color": "#ffffff"
            },
            ".item-title, .item-wrap": {
